# Vision RAG Engine Environment Settings

# API Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=vision_rag_docs

# Embedding & Vision Models
EMBEDDING_MODEL=BAAI/bge-m3
VISION_EMBEDDING_MODEL=google/siglip-base-patch16-224

# LLM Engine (vLLM / Ollama)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llava
LLM_API_KEY=
OPENAI_API_KEY=
